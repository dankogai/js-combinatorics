{
  "name": "js-combinatorics",
  "version": "2.1.4",
  "description": "Simple combinatorics like power set, combination, and permutation in JavaScript",
  "main": "combinatorics.js",
  "module": "combinatorics.js",
  "type": "module",
  "types": "combinatorics.d.ts",
  "sideEffects": false,
  "files": [
    "combinatorics.d.ts",
    "combinatorics.js",
    "umd",
    "commonjs"
  ],
  "exports": {
    "import": "./combinatorics.js",
    "require": "./commonjs/combinatorics.js"
  },
  "scripts": {
    "build": "rollup -c && tsc -p . --declaration --emitDeclarationOnly",
    "clean": "node -e \"['combinatorics.js','combinatorics.d.ts','umd/combinatorics.js','commonjs/combinatorics.js'].forEach(f=>require('fs').rmSync(f,{force:true}))\"",
    "test": "npm run build && mocha",
    "version": "npm run build && node util/sync-version.cjs && git add combinatorics.js combinatorics.d.ts umd/combinatorics.js commonjs/combinatorics.js README.md"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^20.9.0",
    "chai": "^4.2.0",
    "mocha": "^10.0.0",
    "rollup": "^4.62.3",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/dankogai/js-combinatorics.git"
  },
  "keywords": [
    "Combinatorics",
    "combination",
    "permutation"
  ],
  "author": "Dan Kogai",
  "license": "MIT",
  "readmeFilename": "README.md"
}
